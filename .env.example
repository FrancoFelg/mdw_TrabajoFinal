# =============================================================================
# Copiar a `.env` en la raíz del repo. El .env real NUNCA se commitea.
# Lo usan:
#   - dev:  `pnpm dev` + infra/docker/docker-compose.dev.yaml
#   - prod: docker compose --env-file .env -f infra/docker/docker-compose.prod.yaml
# =============================================================================

# --- MySQL ---
# En PROD: passwords SOLO alfanuméricos (nada de ? ( ) @ # % & ;), rompen el
# parseo de DATABASE_URL. Generar con: openssl rand -hex 24
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=mdw_dev
MYSQL_USER=mdw_user
MYSQL_PASSWORD=mdw_pass

# --- Connection string (solo la usa la app en DEV, corriendo fuera de Docker) ---
# En prod el compose arma DATABASE_URL solo, apuntando al servicio `db`.
MYSQL_HOST=localhost
MYSQL_PORT=3307
DATABASE_URL=mysql://mdw_user:mdw_pass@localhost:3307/mdw_dev

# --- App ---
# Firma de los JWT (src/lib/auth.ts). Obligatorio en dev y prod.
# Generar con: openssl rand -hex 64
JWT_SECRET=

# --- Google Maps ---
# Key de Google Maps Platform. La usan services/googleMaps.client.ts
# (Places API (New) para geocoding y autocompletado, Routes API para el ETA).
# Solo la usa el server: NO lleva prefijo NEXT_PUBLIC_, nunca llega al navegador.
# Restringirla en Google Cloud a esas dos APIs. Si falta, esos endpoints
# devuelven 503 (el alta de emergencias por GPS sigue funcionando).
GOOGLE_MAPS_API_KEY=