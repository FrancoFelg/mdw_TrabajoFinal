generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Rol {
  ADMIN
  COORDINADOR
  VOLUNTARIO
}

model Persona {
  id        String   @id @default(cuid())
  apellido  String
  nombre    String
  fechaNac  DateTime
  creadoEn  DateTime @default(now())

}

model Usuario {
  id        String   @id @default(cuid())
  nombreUsuario String   @unique
  password  String
  rol       Rol      @default(VOLUNTARIO)
  personaId String
  persona   Persona  @relation(fields: [personaId], references: [id])
  creadoEn  DateTime @default(now())
}